# Android (patched: v2 signing via apksigner, uncompressed resources.arsc)
SDKPREFIX=/opt/android-sdk
JAVA_HOME=/usr
BT=$(SDKPREFIX)/build-tools/30.0.3

OBJS=lib/arm64-v8a/libdrawterm.so

all: drawterm.apk

clean:
	rm -f *.apk lib/*/*.so

lib/arm64-v8a/libdrawterm.so:
	CONF=android-arm64 make -j5;
	CONF=android-arm64 make clean;

lib/armeabi-v7a/libdrawterm.so:
	CONF=android-arm make -j5;
	CONF=android-arm make clean;

lib/x86/libdrawterm.so:
	CONF=android-386 make -j5;
	CONF=android-386 make clean;

lib/x86_64/libdrawterm.so:
	CONF=android-amd64 make -j5;
	CONF=android-amd64 make clean;

# zipalign FIRST, then apksigner (v2/v3 signatures break if you align afterwards)
drawterm.apk: drawterm-aligned.apk drawterm.keystore
	$(BT)/apksigner sign --ks ./drawterm.keystore --ks-pass pass:glendarocks --key-pass pass:glendarocks --ks-key-alias drawtermKey --out $@ $<
	$(BT)/apksigner verify -v $@

drawterm-aligned.apk: drawterm-unsigned.apk
	$(BT)/zipalign -v -f 4 $< $@

# -0 arsc: Android 11+ (targetSdk>=30) requires resources.arsc stored uncompressed
drawterm-unsigned.apk: $(OBJS)
	$(BT)/aapt package -v -f -0 arsc -M gui-android/AndroidManifest.xml -S gui-android/res -I $(SDKPREFIX)/platforms/android-33/android.jar -F $@ gui-android/bin
	$(BT)/aapt add $@ $(OBJS)

drawterm.keystore:
	$(JAVA_HOME)/bin/keytool -genkeypair -validity 1000 -dname "CN=9front,O=Android,C=US" -keystore $@ -storepass glendarocks -keypass glendarocks -alias drawtermKey -keyalg RSA -v
